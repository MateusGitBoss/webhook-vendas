# Banco principal (local: docker compose; produção: Railway/Supabase)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vendas
# Banco usado só pelos testes (é apagado a cada teste)
DATABASE_URL_TESTE=postgresql+psycopg://postgres:postgres@localhost:5432/vendas_teste

# Segredos das plataformas (cada uma mostra o seu no painel de webhooks)
HOTMART_HOTTOK=troque-este-token-hotmart
KIWIFY_TOKEN=troque-este-token-kiwify

# Chave usada para "embaralhar" e-mails antes de gravar (LGPD). Nunca mude depois de usar.
HASH_SEGREDO=troque-esta-chave-longa-e-aleatoria
# Token exigido nas rotas com dados de cliente (bot do Discord usa este)
API_TOKEN=troque-este-token-da-api

# Canal do Discord que recebe as vendas (vazio = só log)
DISCORD_WEBHOOK_URL=
# Origens liberadas no CORS (painel React)
CORS_ORIGENS=http://localhost:5173
